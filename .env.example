
# Environment
ENV_FOR_DYNACONF=development

# Database
# NOTE: this flat key overrides ANY environment-specific database_url set in
# config/settings.toml (including [testing]), because Dynaconf gives .env
# the highest precedence. Leave this unset locally if you want the
# [testing]/[development] sections in settings.toml to take effect.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/agent_analyse

# Analyst
ANALYST_CLIENT_ID=demo-real-estate
ANALYST_MODEL=mock-model

# Langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Telegram
TELEGRAM_BOT_TOKEN=ton_token_ici
TELEGRAM_ALLOWED_CHAT_ID=
