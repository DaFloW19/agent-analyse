
# Environment
ENV_FOR_DYNACONF=development

# Database
# NOTE: this flat key overrides ANY environment-specific database_url set in
# config/settings.toml (including [testing]), because Dynaconf gives .env
# the highest precedence. Leave this unset locally if you want the
# [testing]/[development] sections in settings.toml to take effect.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/agent_analyse

# Analyst
ANALYST_CLIENT_ID=demo-real-estate
ANALYST_MODEL=mock-model

# Other agents (live data pull, best-effort -- Analyst falls back to
# simulated data if any of these are unreachable)
CRM_KEEPER_URL=http://localhost:8000
MEDIA_BUYER_URL=http://localhost:8004
CONTENT_STRATEGIST_URL=http://localhost:8000

# Langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# LLM (B7 weekly report plain-language summary). Blank key = summary
# generation is a clean no-op; the report shows "unavailable" instead.
# DeepSeek is the team's default (LLM_MODEL blank = deepseek/deepseek-chat).
# Override LLM_MODEL to switch provider (e.g. while DeepSeek billing is
# down) without touching any code -- litellm routes by the model prefix.
# Only the active provider's key needs to be set.
LLM_MODEL=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=ton_token_ici
TELEGRAM_ALLOWED_CHAT_ID=
